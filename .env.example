# Tabletop Arena local LAN configuration example. scripts/start-local.ps1 creates .env for you.
DATABASE_URL=postgresql://tabletop:change-me@127.0.0.1:5432/tabletop_arena?schema=public
SESSION_SECRET=replace-with-a-long-random-secret
JWT_SECRET=replace-with-another-long-random-secret
PUBLIC_APP_URL=http://192.168.1.25:8080
SOCKET_PATH=/socket.io
NODE_ENV=development
SERVER_PORT=4000
WEB_PORT=3000
PROXY_PORT=8080
DEV_PROXY_PORT=8080
PROXY_HOST=0.0.0.0
UPSTREAM_HOST=127.0.0.1
